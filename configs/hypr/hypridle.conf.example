general {
    lock_cmd = /home/erik/.config/hypr/scripts/lock.sh
    before_sleep_cmd = loginctl lock-session
    after_sleep_cmd = hyprctl eval 'return hl.dsp.dpms("on")'
    # Wait for the compositor to confirm the lock before letting the
    # machine suspend. Without this the lid closes on an unlocked session.
    inhibit_sleep = 3
}

listener {
    timeout = 300
    on-timeout = /home/erik/.config/hypr/scripts/lock.sh
}

listener {
    timeout = 360
    on-timeout = hyprctl eval 'return hl.dsp.dpms("off")'
    on-resume = hyprctl eval 'return hl.dsp.dpms("on")'
}
